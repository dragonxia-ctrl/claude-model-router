{
  "router": {
    "host": "127.0.0.1",
    "port": 17861,
    "token": "REPLACE_WITH_64_CHARACTER_HEX_LOCAL_TOKEN"
  },
  "providers": {
    "kimi": {
      "baseUrl": "https://api.moonshot.cn/anthropic",
      "model": "kimi-k3.1-pro",
      "apiKey": "REPLACE_WITH_YOUR_KIMI_API_KEY"
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/anthropic",
      "model": "deepseek-flash",
      "apiKey": "REPLACE_WITH_YOUR_DEEPSEEK_API_KEY"
    }
  },
  "routing": {
    "semanticTriage": true,
    "triageMinChars": 40,
    "triageConfidence": 0.8,
    "triageTimeoutMs": 8000,
    "triageMaxInputChars": 6000,
    "deescalation": {
      "enabled": true,
      "minKimiRequests": 4,
      "probeRequests": 2,
      "maxAttempts": 3,
      "maxBackoffRequests": 16,
      "windowToolCalls": 12,
      "windowRequests": 6,
      "windowMs": 300000,
      "retryAfterExhaustedRequests": 16,
      "minRecentToolCalls": 4,
      "maxFailureRate": 0.1,
      "minFailureDenominator": 10,
      "relapseConfirmations": 2,
      "maxMutationRepeats": 2,
      "latencyCheckpoint": {
        "enabled": false,
        "enterRatio": 0.6,
        "exitRatio": 0.8,
        "samples": 3,
        "fastWindowMs": 90000,
        "cooldownRequests": 8,
        "minReadOnlyShare": 0.5,
        "minOutputTokens": 20,
        "minBaselineSamples": 3
      }
    }
  },
  "telemetry": {
    "persist": false,
    "retentionDays": 30,
    "maxFileBytes": 33554432
  }
